generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum AccountRole {
  USER
  CREATOR
  ADMINISTRATOR
}

enum VenueCategory {
  BAR
  CLUB
  ROOFTOP
  LIVE_MUSIC
  LOUNGE
  OTHER
}

enum PriceRange {
  BUDGET    // $
  MODERATE  // $$
  UPSCALE   // $$$
  LUXURY    // $$$$
}

enum SharePlatform {
  INSTAGRAM
  TIKTOK
  LINK
  COPY
}

// ---------- Core ----------

model Account {
  id               String      @id @default(uuid())
  name             String
  email            String      @unique
  passwordHash     String
  avatarUrl        String?
  role             AccountRole @default(CREATOR)
  active           Boolean     @default(true)
  points           Int         @default(0)
  createdByAdminId String?
  lastLoginAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // SQL Server requires NoAction on self-referential relations to avoid cycle errors
  createdBy       Account?  @relation("CreatedBy", fields: [createdByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAccounts Account[] @relation("CreatedBy")

  createdVenues    Venue[]  @relation("VenueCreatedBy")
  lastEditedVenues Venue[]  @relation("VenueLastEditedBy")
  reviews          Review[]
  createdInvites   Invite[] @relation("InviteCreatedBy")
  ownedInvites     Invite[] @relation("InviteOwnedBy")

  @@map("accounts")
}

// ---------- Invites ----------

model Invite {
  id               String    @id @default(uuid())
  code             String    @unique
  note             String?
  expiresAt        DateTime?
  usedAt           DateTime?
  usedByAccountId  String?
  createdByAdminId String?
  ownedByAccountId String?
  createdAt        DateTime  @default(now())

  createdByAdmin  Account?  @relation("InviteCreatedBy", fields: [createdByAdminId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ownedByAccount  Account?  @relation("InviteOwnedBy", fields: [ownedByAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("invites")
}

// ---------- Venues ----------

model Venue {
  id             String        @id @default(uuid())
  name           String
  category       VenueCategory @default(OTHER)
  address        String
  lat            Float
  lng            Float
  city           String        @default("Bangkok")
  coverCharge    Int?
  musicGenres    Json          // ["House", "Techno"]
  crowdTypes     Json          // ["Couples", "Mixed"]
  priceRange     PriceRange?
  hoursJson      Json?
  photos         Json          // ["url1", "url2"]
  googlePlaceId  String?       @unique
  isPublished    Boolean       @default(false)
  isClosed       Boolean       @default(false)
  closedCheckedAt DateTime?
  createdById    String
  lastEditedById String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdBy    Account  @relation("VenueCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastEditedBy Account  @relation("VenueLastEditedBy", fields: [lastEditedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviews      Review[]

  @@index([city, isPublished])
  @@index([lat, lng])
  @@map("venues")
}

// ---------- Reviews ----------

model Review {
  id              String   @id @default(uuid())
  venueId         String
  accountId       String
  rating          Int
  textBody        String
  media           Json     // [{ url: string, type: "photo" | "video" }]
  tags            Json     // ["great-vibe", "loud"]
  musicGenreNotes String?
  priceLevelNotes String?
  crowdNotes      String?
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  venue       Venue        @relation(fields: [venueId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  account     Account      @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shareEvents ShareEvent[]

  @@unique([accountId, venueId])
  @@index([venueId, isPublished])
  @@index([accountId])
  @@map("reviews")
}

// ---------- Viral loop tracking ----------

model ShareEvent {
  id        String        @id @default(uuid())
  reviewId  String
  platform  SharePlatform
  createdAt DateTime      @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([reviewId])
  @@index([platform, createdAt])
  @@map("share_events")
}
