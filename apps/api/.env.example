# Zeabur: copy the PostgreSQL connection string from your Zeabur PostgreSQL service
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET="replace-with-a-strong-random-secret"

JWT_EXPIRES_IN="7d"
PORT="4000"

# Add your Flutter web Zeabur domain here, e.g. https://nightcheck.zeabur.app
CORS_ORIGINS="http://localhost:5001,https://your-flutter-app.zeabur.app"
